# HTTP server
PORT=3000
JSON_BODY_LIMIT=50mb

# Genesys OAuth (PKCE login)
# Create an OAuth client in Genesys Cloud Admin → Integrations → OAuth
GENESYS_OAUTH_CLIENT_ID=
GENESYS_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback.html
GENESYS_OAUTH_SCOPES=

# Optional: primary org for org-picker OAuth flow
GENESYS_PRIMARY_ORG_ID=

# Mock API limits and lifecycle (optional overrides)
# MOCK_API_MAX_RESPONSE_BODY_BYTES=262144
# MOCK_API_MAX_REQUEST_BODY_BYTES=262144
# MOCK_API_MAX_HEADERS=20
# MOCK_API_MAX_HEADER_VALUE_BYTES=2048
# MOCK_API_MAX_ENDPOINTS_PER_USER=25
# MOCK_API_MAX_REQUEST_LOGS_PER_ENDPOINT=1000
# MOCK_API_INACTIVITY_MS=7200000
# MOCK_API_MAX_LIFETIME_MS=86400000
# MOCK_API_RETENTION_EXPIRED_MS=604800000
# MOCK_API_PURGE_INTERVAL_MS=3600000
# MOCK_API_MAX_DELAY_MS=30000

# Optional: authorized org list when trustor lookup is unavailable
# GENESYS_AUTHORIZED_ORGS=
# GENESYS_AUTHORIZED_ORG_NAMES=

# Launch endpoint / credential vault (required for extension pairing)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=
# Optional HMAC secret for signed extension requests (recommended in production)
LAUNCH_HMAC_SECRET=
# Public base URL for launch redirects (defaults to request host)
# LAUNCH_BASE_URL=http://localhost:3000
# LAUNCH_VAULT_TTL_MS=28800000
# LAUNCH_CODE_TTL_MS=60000
